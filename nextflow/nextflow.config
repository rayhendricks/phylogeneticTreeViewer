params.outdir = 'localtree_out'

process {
    withName: 'LOCALTREE_RENDER' {
        // Any extra command line options, e.g. layout and branch coloring:
        ext.args   = '--midpoint --color-by species'
        publishDir = [path: "${params.outdir}/families", mode: 'copy', pattern: '*.{svg,html,session.json}']
    }
    withName: 'LOCALTREE_DASHBOARD' {
        ext.args   = { "--title '${params.title}' --svg" }
        publishDir = [path: params.outdir, mode: 'copy', pattern: 'localtree_dashboard']
    }
}

profiles {
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    local       { process.container = null }
}
